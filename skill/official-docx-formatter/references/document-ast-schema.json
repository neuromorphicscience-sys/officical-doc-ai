{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Official DOCX structure protocol with host-agent provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentType",
    "confidence",
    "blocks",
    "source",
    "inputSHA256"
  ],
  "properties": {
    "documentType": {
      "enum": [
        "通知",
        "请示",
        "报告",
        "函",
        "会议纪要",
        "工作总结",
        "规章制度",
        "其他"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "enum": [
        "host-agent",
        "deepseek",
        "demo"
      ]
    },
    "inputSHA256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "string"
    },
    "requestId": {
      "type": "string"
    },
    "demoReason": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paragraphId",
          "type",
          "reason"
        ],
        "properties": {
          "paragraphId": {
            "type": "integer",
            "minimum": 0
          },
          "type": {
            "enum": [
              "missing_heading_number",
              "text_normalization",
              "review"
            ]
          },
          "reason": {
            "type": "string"
          },
          "proposedText": {
            "type": "string"
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "title",
              "recipient",
              "body",
              "heading",
              "attachment_note",
              "attachment_marker",
              "attachment_title",
              "issuer",
              "date",
              "annotation",
              "unknown"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rationale": {
            "type": "string"
          },
          "parentId": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "suggestedNumber": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "heading"
                }
              }
            },
            "then": {
              "required": [
                "level"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "level"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
